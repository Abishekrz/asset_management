extends ../layout

//- block scripts
//-     script(src="/js/asset.js")
    
block content

    .d-flex.justify-content-between.align-items-center.mb-4

        h2 Asset List

        a.btn.btn-primary(
            type="button" 
            data-bs-toggle='modal'
            data-bs-target='#assetModal'
        )
            |Add Asset
    //-     Status Filter
    .row.mb-3
        .col-md-2
            select.form-select#assetStatusFilter
                option(value="") All Status

        .col-md-2
            select.form-select#makeFilter
                option(value="") All Make
        .col-md-2
            select.form-select#modelFilter
                option(value="") All Model

        .col-md-2
            select.form-select#categoryFilter
                option(value="") All Category

        .col-md-2
            select.form-select#warrantyFilter
                option(value="") All Warranty

    .table-responsive
        table.datatable.table.table-striped.table-bordered.w-200

            thead.table-dark
                tr
                    th Asset ID 
                    th Asset Name
                    th Serial Number
                    th Make
                    th Model
                    th Purchase Date
                    th Purchase Price
                    th Status
                    th Category Id
                    th Warranty
                    th Action
            tbody
                each asset in assets 
                    tr
                        td= asset.asset_id 
                        td= asset.asset_name 
                        td= asset.serial_number 
                        td= asset.make 
                        td= asset.model
                        td= asset.purchase_date 
                        td= asset.purchase_price
                        td= asset.status 
                        td= asset.category_id
                        td= asset.warranty
                        

                        td
                            button.btn.btn-warning.btn-sm(
                                type="button"
                                onclick=`editAsset(${asset.asset_id})`
                            ) Edit
                            
                            a.btn.btn-danger.btn-sm.ms-2(
                                href="/asset/delete/" + asset.asset_id
                                onclick="return confirm('Are you sure you want to delete this asset?')"
                            ) Delete
                // Asset Modal
                #assetModal.modal.fade(tabindex="-1")
                    .modal-dialog.modal-lg
                        .modal-content

                            .modal-header
                                h5#assetModalTitle.modal-title Add Asset
                                button.btn-close(
                                    type="button"
                                    data-bs-dismiss="modal"
                                )

                            form#assetForm(
                                action="/asset/add"
                                method="POST"
                            )

                                .modal-body

                                    input(
                                        type="hidden"
                                        name="asset_id"
                                        id="asset_id"
                                    )

                                    .row

                                        .col-md-6.mb-3
                                            label Asset Name
                                            input.form-control(
                                                type="text"
                                                name="asset_name"
                                                id="asset_name"
                                                required
                                            )

                                        .col-md-6.mb-3
                                            label Serial Number
                                            input.form-control(
                                                type="text"
                                                name="serial_number"
                                                id="serial_number"
                                                required
                                            )

                                        .col-md-6.mb-3
                                            label Make
                                            input.form-control(
                                                type="text"
                                                name="make"
                                                id="make"
                                            )

                                        .col-md-6.mb-3
                                            label Model
                                            input.form-control(
                                                type="text"
                                                name="model"
                                                id="model"
                                            )

                                        .col-md-6.mb-3
                                            label Purchase Date
                                            input.form-control(
                                                type="date"
                                                name="purchase_date"
                                                id="purchase_date"
                                            )

                                        .col-md-6.mb-3
                                            label Purchase Price
                                            input.form-control(
                                                type="number"
                                                name="purchase_price"
                                                id="purchase_price"
                                            )

                                        .col-md-6.mb-3
                                            label Warranty
                                            select.form-select(
                                                name="warranty"
                                                id="warranty"
                                            )
                                                option(value="YES") YES
                                                option(value="NO") NO

                                        .col-md-6.mb-3
                                            label Status
                                            select.form-select(
                                                name="status"
                                                id="status"
                                            )
                                                option(value="IN_STOCK") IN_STOCK
                                                option(value="ISSUED") ISSUED
                                                option(value="REPAIR") REPAIR
                                                option(value="SCRAPPED") SCRAPPED

                                        .col-md-6.mb-3
                                            label Category

                                            select.form-select(
                                                name="category_id"
                                                id="category_id"
                                            )
                                                each category in categories
                                                    option(value=category.category_id)= category.category_name

                                .modal-footer

                                    button.btn.btn-secondary(
                                        type="button"
                                        data-bs-dismiss="modal"
                                    ) Cancel

                                    button.btn.btn-success(
                                        type="submit"
                                    ) Save 

                // Delete Asset Modal
                #deleteAssetModal.modal.fade(tabindex="-1" aria-labelledby="deleteAssetModalLabel" aria-hidden="true")
                    .modal-dialog
                        .modal-content
                            form#deleteAssetForm(method="GET")
                                .modal-header.bg-danger.text-white
                                    h5#deleteAssetModalLabel.modal-title Delete Asset
                                    button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")

                                .modal-body
                                    input#delete_asset_id(type="hidden" name="asset_id")

                                    p.mb-0
                                        | Are you sure you want to delete asset
                                        strong#delete_asset_name.ms-1
                                        | ?

                                .modal-footer
                                    button.btn.btn-secondary(type="button" data-bs-dismiss="modal")
                                        i.bi.bi-x-circle.me-1
                                        | Cancel

                                    button.btn.btn-danger(type="submit")
                                        i.bi.bi-trash.me-1
                                        | Delete
                