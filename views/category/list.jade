extends ../layout

//- block scripts
//-     script(src="/js/category.js")

block content

    .d-flex.justify-content-between.align-items-center.mb-4

        h2 Category List

        a.btn.btn-primary(
            type='button'
            data-bs-toggle='modal'
            data-bs-target='#categoryModal'
        )
            | Add Category

    table.datatable.table.table-striped.table-bordered

        thead.table-dark
            tr
                th Category ID
                th Category Name
                th Action
        tbody 
            each category in categories 
                tr 
                    td=category.category_id
                    td=category.category_name

                    td
                        a.btn.btn-warning.btn-sm(
                            type='button'
                            onclick=`editCategory(${category.category_id})`
                        ) Edit

                        button.btn.btn-danger.btn-sm.ms-2(
                            type="button"
                            onclick=`deleteCategory(${category.category_id}, '${category.category_name}')`
                        )
                            i.bi.bi-trash
                            |  Delete
    // Delete Category Modal
    #deleteCategoryModal.modal.fade(tabindex="-1", aria-hidden="true")
        .modal-dialog
            form#deleteCategoryForm(method="POST")
                .modal-content

                    .modal-header.bg-danger.text-white
                        h5.modal-title Delete Category
                        button.btn-close.btn-close-white(
                            type="button",
                            data-bs-dismiss="modal"
                        )

                    .modal-body
                        input#delete_category_id(
                            type="hidden",
                            name="category_id"
                        )

                        p
                            | Are you sure you want to delete the category 
                            strong#delete_category_name
                            |  ?

                    .modal-footer
                        button.btn.btn-secondary(
                            type="button",
                            data-bs-dismiss="modal"
                        ) Cancel

                        button.btn.btn-danger(type="submit")
                            i.bi.bi-trash
                            |  Delete

