extends ../layout

block scripts
    script(src="/js/employee.js")

block content

    .d-flex.justify-content-between.align-items-center.mb-4
        h2 Employee List

        

        a.btn.btn-primary(
            type="button"
            data-bs-toggle='modal'
            data-bs-target='#employeeModal'
        )
            |Add Employee
    .row.mb-3
        .col-md-2
            select.form-select#employeeStatusFilter
                option(value="") All Employee Status

        .col-md-2
            select.form-select#departmentFilter
                option(value="") All Departement 
        .col-md-2
            select.form-select#branchFilter
                option(value="") All Branch


    table.datatable.table.table-striped.table-bordered

        thead.table-dark
            tr
                th Employee ID
                th Employee Name
                th Email
                th Department
                th Branch
                th Joined_At
                th Status
                th Action

        tbody
            each employee in employees
                tr
                    td= employee.employee_id
                    td= employee.employee_name
                    td= employee.email
                    td= employee.department
                    td= employee.branch
                    td= employee.joined_at
                    td= employee.status

                    td
                        a.btn.btn-warning.btn-sm(
                            type="button"
                            onclick=`editEmployee(${employee.employee_id})`
                        ) Edit

                        
                        a.btn.btn-danger.btn-sm.ms-2(
                            href="/employee/changestatus/" + employee.employee_id
                            onclick="return confirm('Are you sure you want to delete this employee?')"
                        ) Change Status

        #employeeModal.modal.fade(tabindex="-1")
                .modal-dialog.modal-lg
                    .modal-content

                        .modal-header
                            h5#employeeModalTitle.modal-title Add Employee
                            button.btn-close(
                                type="button"
                                data-bs-dismiss="modal"
                                data-bs-target='#employeeModal'

                            )

                        form#employeeForm(
                            action="/employee/add"
                            method="POST"
                        )

                            .modal-body

                                input(
                                    type="hidden"
                                    name="employee_id"
                                    id="employee_id"
                                )

                                .row

                                    .col-md-6.mb-3
                                        label Employee Name
                                        input.form-control(
                                            type="text"
                                            name="employee_name"
                                            id="employee_name"
                                            required
                                        )
                                    .col-md-6.mb-3
                                        label(for="email") Email
                                        input.form-control(
                                            type="email"
                                            id="email"
                                            name="email"
                                            placeholder="Enter email"
                                            required
                                        )
                                    .col-md-6.mb-3
                                        label Department
                                        input.form-control(
                                            type="text"
                                            name="department"
                                            id="department"
                                            required
                                        )
                                    .col-md-6.mb-3
                                        label Branch
                                        input.form-control(
                                            type="text"
                                            name="branch"
                                            id="branch"
                                            required
                                        )
                                    .col-md-6.mb-3
                                        label Status
                                        select.form-select(
                                            name="status"
                                            id="status"
                                            required
                                        )
                                            option(value="ACTIVE") Active
                                            option(value="INACTIVE") Inactive
                                    .col-md-6.mb-3
                                        label Joining Date
                                        input.form-control(
                                            type="date"
                                            name="joined_at"
                                            id="joined_at"
                                            required
                                        )
                            .modal-footer

                                button.btn.btn-secondary(
                                    type="button"
                                    data-bs-dismiss="modal"
                                ) Cancel

                                button.btn.btn-success(
                                    type="submit"
                                ) Save  
        // Delete Employee Modal
        #deleteEmployeeModal.modal.fade(tabindex="-1" aria-labelledby="deleteEmployeeModalLabel" aria-hidden="true")
            .modal-dialog
                .modal-content
                    form#deleteEmployeeForm(method="POST")
                        .modal-header.bg-danger.text-white
                            h5#deleteEmployeeModalLabel.modal-title Delete Employee
                            button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")

                        .modal-body
                            input#delete_employee_id(type="hidden" name="employee_id")

                            p.mb-0
                                | Are you sure you want to delete employee
                                strong#delete_employee_name.ms-1
                                | ?

                        .modal-footer
                            button.btn.btn-secondary(type="button" data-bs-dismiss="modal")
                                i.bi.bi-x-circle.me-1
                                | Cancel

                            button.btn.btn-danger(type="submit")
                                i.bi.bi-trash.me-1
                                | Delete